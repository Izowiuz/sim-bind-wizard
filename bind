#!/usr/bin/env python3
"""bind - run one game's binding tools

SYNOPSIS
    ./bind
    ./bind GAME [VERB] [ARG...]

DESCRIPTION
    With no arguments, print which verbs each game answers.
    VERB defaults to `tui`, or `plan` where a game has no review
    screen. Anything after it is passed to the script.

    With more than one desk in the device map and none named, this
    asks which. Say it outright with `--desk NAME` or
    SIM_DEVICE_PROFILE.

VERBS
    harvest   read the game's files, write the vocabulary cache
    plan      what it would bind, and where
    why       the same, plus the evidence for each control
    free      controls left unbound
    sheet     write KNEEBOARD.md and kneeboard.html
    tui       review the layout, write what you keep
    write     the whole layout, into the game
    capture   the curses capture wizard

GAMES
    dcs  elite (ed)  falconbms (bms)  msfs  warthunder (wt)  x4

EXAMPLES
    ./bind wt why --desk IzoDesk
    ./bind x4 sheet
    ./bind bms plan --audit

NOTES
    A verb a game does not answer is omitted; `./bind` prints the reason.
    Every planner owns --write. War Thunder and DCS delegate it to the
    script that owns their file format.
"""

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

#: verb -> (script, fixed arguments). Order here is the order they print in.
VERBS = ('harvest', 'plan', 'why', 'free', 'sheet', 'tui', 'write', 'capture')

#: game -> {alias, verb: (script, fixed arguments)}. The games themselves are
#: not listed here: `discover()` reads `games/` for those, so a new folder is
#: visible without anybody editing this file. What stays written out is which
#: flags a verb maps to, because asking an adapter would mean constructing
#: one, and constructing reads caches and the device map -- `./bind` with no
#: arguments has to stay instant on a clone where nothing is harvested.
#:
#: `tests/test_contract.py` checks every row against the adapter's real
#: parser, and checks that every verb withheld has a reason in GAPS. The
#: table can be incomplete; it can no longer be wrong.
VERB_ROWS = {
    'falconbms': {
        'alias': ('bms',),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('plan.py', ()),
        'why':     ('plan.py', ('--why',)),
        'free':    ('plan.py', ('--free',)),
        'sheet':   ('plan.py', ('--sheet', '--html')),
        'tui':     ('plan.py', ('--tui',)),
        # one layout, two files: the key file and the axis mapping
        'write':   ('plan.py', ('--write', '--write-axes')),
    },
    'warthunder': {
        'alias': ('wt',),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('plan.py', ()),
        'why':     ('plan.py', ('--why',)),
        'free':    ('plan.py', ('--unused',)),
        'sheet':   ('plan.py', ('--sheet', 'KNEEBOARD.md',
                                '--html', 'kneeboard.html')),
        'tui':     ('plan.py', ('--tui',)),
        'write':   ('plan.py', ('--write',)),
    },
    'msfs': {
        'alias': (),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('plan.py', ()),
        'why':     ('plan.py', ('--why',)),
        'free':    ('plan.py', ('--free',)),
        'sheet':   ('plan.py', ('--sheet', '--html')),
        'tui':     ('plan.py', ('--tui',)),
        'write':   ('plan.py', ('--write',)),
    },
    'x4': {
        'alias': (),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('plan.py', ()),
        'why':     ('plan.py', ('--why',)),
        'free':    ('plan.py', ('--free',)),
        'sheet':   ('plan.py', ('--sheet', '--html')),
        'tui':     ('plan.py', ('--tui',)),
        'write':   ('plan.py', ('--write',)),
    },
    'dcs': {
        'alias': (),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('propose.py', ()),
        'why':     ('propose.py', ('--why',)),
        'free':    ('propose.py', ('--free',)),
        'sheet':   ('propose.py', ('--sheet', '--html')),
        'write':   ('propose.py', ('--write',)),
        'capture': ('dcs-bind-wizard.py', ()),
    },
    'elite': {
        'alias': ('ed',),
        'harvest': ('harvest.py', ('--json',)),
        'plan':    ('plan.py', ()),
        'why':     ('plan.py', ('--why',)),
        'free':    ('plan.py', ('--free',)),
        'sheet':   ('plan.py', ('--sheet', '--html')),
        'tui':     ('plan.py', ('--tui',)),
        'write':   ('plan.py', ('--write',)),
        'capture': ('ed-bind-wizard.py', ()),
    },
}


def discover():
    """{game: title} -- every folder under games/, titled by its README.

    The title is the first line of `games/<game>/README.md`, which is a
    contract clause a test already enforces, so it is a heading that cannot
    quietly go missing.
    """
    root = os.path.join(HERE, 'games')
    out = {}
    for name in sorted(os.listdir(root)):
        if name.startswith('.') or not os.path.isdir(
                os.path.join(root, name)):
            continue
        title = name
        try:
            with open(os.path.join(root, name, 'README.md'),
                      encoding='utf-8') as f:
                first = f.readline().strip()
            if first.startswith('# '):
                title = first[2:].strip()
        except OSError:
            pass
        out[name] = title
    return out


TITLES = discover()
GAMES = {g: dict(VERB_ROWS.get(g, {}), title=t) for g, t in TITLES.items()}


#: Where a verb is missing, why -- printed in the table so a gap reads as a
#: fact about the game rather than as an omission here.
GAPS = {
    ('dcs', 'tui'): 'its capture wizard already is one — ./bind dcs capture',
    ('falconbms', 'capture'): 'no capture wizard',
    ('warthunder', 'capture'): 'no capture wizard',
    ('msfs', 'capture'): 'no capture wizard',
    ('x4', 'capture'): 'no capture wizard',
}


def resolve(name):
    """A game folder from a name or an alias."""
    if name in GAMES:
        return name
    for game, spec in GAMES.items():
        if name in spec.get('alias', ()):
            return game
    return None


def table():
    width = max(len(g) for g in GAMES) + 2
    print(f'{"game":<{width}}' + ''.join(f'{v:<9}' for v in VERBS))
    for game in sorted(GAMES):
        spec = GAMES[game]
        cells = []
        for verb in VERBS:
            cells.append('·' if verb in spec else '–')
        print(f'{game:<{width}}' + ''.join(f'{c:<9}' for c in cells)
              + f'  {spec["title"]}')
    print()
    print('· available   – not offered')
    aliases = [(a, g) for g, s in sorted(GAMES.items())
               for a in s.get('alias', ())]
    if aliases:
        print('aliases: ' + ', '.join(f'{a} = {g}' for a, g in aliases))
    if GAPS:
        print()
        for (game, verb), why in sorted(GAPS.items()):
            print(f'  {game} {verb}: {why}')


def default_verb(game):
    """The verb a bare `./bind <game>` runs.

    The screen, where there is one. It used to be `plan`, which prints the
    layout -- the thing you read once to see whether the allocator got it
    right, rather than the thing you come back to.

    DCS has no `tui`: its capture wizard already is one, which `GAPS` says
    in those words. Falling through to an error there would make the
    shortest command in the family fail for one game in six.
    """
    return 'tui' if 'tui' in GAMES.get(game, {}) else 'plan'


def which_desk(rest):
    """(desk, where its file was read from), either of which may be None.

    Only asked when there is something to ask: the map cannot settle it
    by itself, nothing was said on the command line or in the
    environment, and somebody is at a terminal to answer. Anywhere else
    this keeps quiet and the planner's own message names the ways of
    saying it.

    One desk on file and there is no question -- but none at all is one:
    the files may be somewhere this does not look yet.
    """
    if any(a == '--desk' or a.startswith('--desk=') for a in rest):
        return None, None
    if os.environ.get('SIM_DEVICE_PROFILE'):
        return None, None
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        return None, None
    if HERE not in sys.path:
        sys.path.insert(0, HERE)
    try:
        dm = __import__('core.devmap', fromlist=['devmap']).load()
    except SystemExit:
        return None, None               # no map; the planner says so better
    where = dm.PROFILES
    while True:
        rigs = [r for r in dm.load_profiles()]
        if len(rigs) == 1 and where == dm.PROFILES:
            return None, None
        desk, said = pick_desk(rigs, where)
        if desk is not None or said is None or said == where:
            return desk, said
        where = said
        dm.PROFILES = said


#: The last row of the desk list: not a desk, a place to look for them.
ELSEWHERE = 'read desks from somewhere else…'


def said_path(where):
    """A directory as somebody would say it, not as the OS spells it."""
    home = os.path.expanduser('~')
    return ('~' + where[len(home):]) if where.startswith(home + os.sep) \
        else where


def desk_items(rigs):
    """One line per desk: what it is called and what is on it.

    What is on it, because the names are yours and a list of them says
    nothing about which room you are in. `nothing on it` is a desk you
    made and have not filled, which is worth seeing before you pick it.
    """
    wide = max((len(r.name) for r in rigs), default=0)
    return [f'{r.name:<{wide}}   '
            + (', '.join(d.get('role') or d['slug'] for d in r.devices)
               or 'nothing on it')
            for r in rigs]


def pick_desk(rigs, where):
    """Put the rigs on the screen the rest of this repo uses.

    Returns `(name, directory)`: the desk to work at and where it was
    read from, either of which may be None. The directory is shown and
    changeable because a desk is a fact about a room -- somebody with two
    rooms, or with these files kept somewhere synced, has to be able to
    say where they are without editing this.
    """
    import curses
    from core import tui as ctui

    def run(scr):
        tui = ctui.setup(scr)
        while True:
            rows = [('plain', t) for t in desk_items(rigs)]
            # A blank between the desks and the row that is not one, and
            # the cursor steps over it: `↵ choose` on a blank row would
            # be a key that does not mean anything.
            rows += [('plain', ''), ('meta', ELSEWHERE)]
            got = tui.choose('Which desk is this for?', rows,
                             head=[('meta', f'read from {said_path(where)}'),
                                   ('plain', '')],
                             skip=[len(rigs)])
            if got is None:
                return None, None
            if got != len(rows) - 1:
                # A desk. Not "anything that is not the last row": the
                # blank between them is not a desk either, and reading
                # it as one is only prevented by `skip` happening to be
                # right.
                return rigs[got].name, where
            said = tui.ask('Read desks from',
                           ['A directory of .toml desks.'], value=where)
            # RETURN on the path you came in with is not a choice of
            # anywhere: it is backing out of the question, and treating
            # it as an answer dropped you into the planner with no desk.
            if not said or said == where:
                continue
            if not os.path.isdir(said):
                tui.popup('Nothing there',
                          [('plain', f'{said} is not a directory.')])
                continue
            return None, said

    try:
        return curses.wrapper(run)
    except curses.error:
        # No terminal that can do this, which the planner's own message
        # covers. Narrow on purpose: a blanket catch here swallowed a
        # mistake inside `run` and reported it as "no terminal".
        return None, None
    return rigs[got].name if got is not None else None


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        if not args:
            table()
        else:
            print(__doc__)
        return 0

    game = resolve(args[0])
    if game is None:
        print(f'no game called {args[0]!r}. Try ./bind with no arguments.',
              file=sys.stderr)
        return 2

    spec = GAMES[game]
    verb = (args[1] if len(args) > 1 and not args[1].startswith('-')
            else default_verb(game))
    rest = args[2:] if len(args) > 1 and not args[1].startswith('-') \
        else args[1:]

    if verb not in spec:
        why = GAPS.get((game, verb))
        print(f'{game} has no {verb!r}'
              + (f': {why}' if why else '')
              + '. Try ./bind with no arguments.', file=sys.stderr)
        return 2

    script, fixed = spec[verb]
    path = os.path.join(HERE, 'games', game, script)
    if not os.path.exists(path):
        print(f'{path} is missing', file=sys.stderr)
        return 2

    desk, where = which_desk(rest)
    env = dict(os.environ)
    if desk:
        env['SIM_DEVICE_PROFILE'] = desk
    if where:
        env['SIM_DEVICE_PROFILES'] = where
    env = env if (desk or where) else None

    cmd = [sys.executable, path, *fixed, *rest]
    print(f'--> games/{game}/{script} '
          + ' '.join([*fixed, *rest]), file=sys.stderr)
    return subprocess.call(cmd, cwd=os.path.join(HERE, 'games', game),
                           env=env)


if __name__ == '__main__':
    sys.exit(main())
