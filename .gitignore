__pycache__/
*.pyc
*.tmp
*.orig
*.bak
*.bak.*

# Harvested from the installed game by each game's harvest.py: the publisher's
# own action names. Not ours to redistribute. Run harvest.py after cloning,
# or after a patch adds actions.
games/*/*-actions.json

# NOT ignored, and the distinction matters. Two files per game hold what
# nobody can derive, and a blanket rule over games/*/*.json would take them
# with the caches:
#
#   <game>-needs.json   what each function IS and how you use it -- which
#                       band it is in, what shape it wants, whether you hold
#                       it down. 147 of them.
#   <game>-binds.json   what sits where, and who decided: your choices, your
#                       acceptances, and what the allocator last produced.
#
# They were one file until the split, so a row said what a function is AND
# where it had ended up, and nothing in it said which half was which. What
# you want of the LAYOUT is in neither: that is overlays/, also in the repo.
!games/*/*-needs.json
!games/*/*-binds.json

# Rendered for review by a writer's --render, never the real thing.
games/warthunder/machine.blk*

# KNEEBOARD.md and kneeboard.html are generated by `plan.py --sheet/--html`
# but kept on purpose: the sheet is the point of the thing and it reads on the
# forge without cloning. Regenerate, do not edit.

# Every game file a writer replaced, one folder per run, with a MANIFEST
# saying where each copy came from (core/backup.py). Yours, not the repo's --
# and the reason the default is here rather than in someone's cloud folder is
# that a backup inside the game's own directory is a file the game can find.
# Move them with --backup-dir or SIM_BIND_BACKUPS.
backups/
